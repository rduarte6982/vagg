# Copy to .env and fill in. NEVER commit .env (it's in .gitignore).

# ----- Runtime -----
VAGG_CORE_ENVIRONMENT=dev
VAGG_CORE_LOG_LEVEL=INFO
VAGG_CORE_BIND_HOST=0.0.0.0
VAGG_CORE_BIND_PORT=8443

# ----- Database -----
# SPEC §2.1: SQLite (WAL mode). For dev, use a relative path.
# In prod, mount a volume at /var/lib/vagg and point to /var/lib/vagg/db.sqlite.
VAGG_CORE_DATABASE_URL=sqlite+aiosqlite:///./vagg-core.db

# ----- Auth (SPEC §13.1) -----
# Bootstrap admin. Hash with: python -m vagg_core.scripts.hash_password 'sua-senha'
VAGG_CORE_ADMIN_EMAIL=admin@consultoria.example
VAGG_CORE_ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$REPLACE_ME

# JWT signing secret (HMAC-SHA256). Generate with: openssl rand -hex 32
VAGG_CORE_JWT_SECRET=REPLACE_WITH_HEX_64_CHARS
VAGG_CORE_JWT_ACCESS_TTL_SECONDS=900
VAGG_CORE_JWT_REFRESH_TTL_SECONDS=604800
VAGG_CORE_JWT_ISSUER=vagg-core

# ----- Domain -----
VAGG_CORE_VIRTUAL_RANGE=10.200.0.0/16
VAGG_CORE_DOMAIN=vpn.consultoria.example

# ----- License (Fase 1 client integration na Fase 9) -----
# VAGG_CORE_LICENSE_KEY=VAGG-XXXX-XXXX-XXXX
# VAGG_CORE_LICENSE_SERVER=https://licensing.vagg.io
