# Copy to .env and fill in. NEVER commit .env (it's in .gitignore).

# ----- Runtime -----
VAGG_LICENSE_ENVIRONMENT=dev
VAGG_LICENSE_LOG_LEVEL=INFO
VAGG_LICENSE_BIND_HOST=0.0.0.0
VAGG_LICENSE_BIND_PORT=8080

# ----- Database -----
# Match the docker-compose.yml service.
VAGG_LICENSE_DATABASE_URL=postgresql+asyncpg://vagg:vagg@localhost:5432/vagg_license

# ----- Ed25519 signing keys -----
# Generate with: python -m vagg_license.scripts.generate_keypair
# Production: keep PRIVATE in a secrets manager (Render env / GCP Secret Manager / Vault).
# IMPORTANT: PEM format including the BEGIN/END lines, with literal \n preserved if your
# secrets manager doesn't support multiline.
VAGG_LICENSE_JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
VAGG_LICENSE_JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----\n"
VAGG_LICENSE_JWT_TTL_SECONDS=604800
VAGG_LICENSE_JWT_ISSUER=vagg-license-server

# ----- Stripe -----
# Test mode: sk_test_... and whsec_...
# Production: sk_live_... and whsec_... (different webhook endpoint per environment)
VAGG_LICENSE_STRIPE_API_KEY=sk_test_REPLACE_ME
VAGG_LICENSE_STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
VAGG_LICENSE_STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# Stripe price IDs from your Stripe dashboard (Products → price IDs).
VAGG_LICENSE_STRIPE_PRICE_ID_STARTER=price_REPLACE_starter
VAGG_LICENSE_STRIPE_PRICE_ID_PROFESSIONAL=price_REPLACE_professional
VAGG_LICENSE_STRIPE_PRICE_ID_ENTERPRISE=price_REPLACE_enterprise
