#!/usr/bin/env bash
# vagg-update — atualizador idempotente com rollback automático (SPEC §9.5).
#
# Fluxo:
#   1. Snapshot: copia DB sqlite + /etc/vagg/core.env → /var/lib/vagg/backups/
#   2. Pull das novas imagens (versão atual de UPDATES_MANIFEST)
#   3. docker compose up -d (zero-downtime quando o ui é stateless)
#   4. Roda alembic upgrade head
#   5. Health check 30 × 2s; se falhar → restaura snapshot + restart antiga

set -Eeuo pipefail

QUIET=0
VAGG_HOME="${VAGG_HOME:-/var/lib/vagg}"
VAGG_ETC="${VAGG_ETC:-/etc/vagg}"
COMPOSE="/usr/bin/docker compose -f ${VAGG_ETC}/docker-compose.yml"
MANIFEST_URL="${MANIFEST_URL:-https://updates.vagg.io/manifest.json}"
BACKUP_DIR="${VAGG_HOME}/backups"

log() { [[ $QUIET -eq 1 ]] && return 0; printf '\033[1;34m[vagg-update]\033[0m %s\n' "$*"; }
fail() { printf '\033[1;31m[vagg-update]\033[0m %s\n' "$*" >&2; exit 1; }

for arg in "$@"; do
    case "$arg" in
        --quiet) QUIET=1 ;;
        *) fail "argumento desconhecido: $arg" ;;
    esac
done

require_root() {
    if [[ $EUID -ne 0 ]]; then fail "rode como root"; fi
}

snapshot() {
    local ts; ts="$(date -u +%Y%m%dT%H%M%SZ)"
    local dir="$BACKUP_DIR/$ts"
    mkdir -p "$dir"
    cp -a "$VAGG_HOME/db" "$dir/db"
    cp -a "$VAGG_ETC/core.env" "$dir/core.env"
    # Mantém apenas os 14 backups mais recentes para não encher disco.
    find "$BACKUP_DIR" -mindepth 1 -maxdepth 1 -type d \
        | sort | head -n -14 | xargs -r rm -rf
    echo "$dir"
}

current_version() {
    grep -E '^VAGG_CORE_TUNNELS_IMAGE_TAG=' "$VAGG_ETC/core.env" \
        | head -1 | cut -d= -f2 || echo "latest"
}

latest_version() {
    if ! command -v curl >/dev/null; then echo ""; return; fi
    curl -fsSL --max-time 5 "$MANIFEST_URL" 2>/dev/null \
        | python3 -c "import sys,json; print(json.load(sys.stdin).get('latest',''))" 2>/dev/null \
        || echo ""
}

apply_version() {
    local version="$1"
    log "atualizando para versão $version"
    sed -i "s|^VAGG_CORE_TUNNELS_IMAGE_TAG=.*|VAGG_CORE_TUNNELS_IMAGE_TAG=${version}|" \
        "$VAGG_ETC/core.env"
    $COMPOSE pull
    $COMPOSE up -d --remove-orphans
    docker run --rm \
        --env-file "$VAGG_ETC/core.env" \
        -v "$VAGG_HOME/db:/var/lib/vagg/db" \
        "ghcr.io/rduarte6982/vagg/core:${version}" \
        alembic upgrade head
}

health_check() {
    local i
    for i in {1..30}; do
        if curl -fs --max-time 2 http://127.0.0.1:8443/api/v1/system/health >/dev/null; then
            return 0
        fi
        sleep 2
    done
    return 1
}

rollback() {
    local snapshot_dir="$1"
    local previous_version
    previous_version="$(grep -E '^VAGG_CORE_TUNNELS_IMAGE_TAG=' \
        "$snapshot_dir/core.env" | cut -d= -f2)"
    log "rollback → $previous_version"
    cp "$snapshot_dir/core.env" "$VAGG_ETC/core.env"
    rm -rf "$VAGG_HOME/db"
    cp -a "$snapshot_dir/db" "$VAGG_HOME/db"
    $COMPOSE pull
    $COMPOSE up -d --remove-orphans
}

main() {
    require_root
    local current latest
    current="$(current_version)"
    latest="$(latest_version)"
    if [[ -z "$latest" ]]; then
        log "manifest indisponível ou versão não encontrada — nada a fazer"
        exit 0
    fi
    if [[ "$latest" == "$current" ]]; then
        log "já na versão mais recente ($current)"
        exit 0
    fi
    log "snapshot antes da atualização..."
    local snap; snap="$(snapshot)"
    if ! apply_version "$latest"; then
        log "apply falhou — rollback"
        rollback "$snap"
        fail "atualização falhou (rollback aplicado)"
    fi
    if ! health_check; then
        log "health check pós-update falhou — rollback"
        rollback "$snap"
        fail "atualização falhou (health check, rollback aplicado)"
    fi
    log "atualização concluída: $current → $latest"
}

main "$@"
